@baseUrl = http://localhost:8080

### Health check
GET {{baseUrl}}/api/v1/health

### Info
GET {{baseUrl}}/api/v1/info

### Create valid product
POST {{baseUrl}}/api/v1/products
Content-Type: application/json

{
  "name": "Mouse Gamer",
  "sku": "MOU-001",
  "quantity": 15,
  "price": 199.90,
  "category": "Peripherals",
  "lowStockThreshold": 5
}

### Get paginated products
GET {{baseUrl}}/api/v1/products?page=0&size=10

### Search products by name or SKU
GET {{baseUrl}}/api/v1/products?search=mouse&page=0&size=10

### Get low-stock products
GET {{baseUrl}}/api/v1/products/low-stock

### Get product by id
GET {{baseUrl}}/api/v1/products/1

### Get product not found
GET {{baseUrl}}/api/v1/products/999

### Create invalid product
POST {{baseUrl}}/api/v1/products
Content-Type: application/json

{
  "name": "",
  "sku": "",
  "quantity": -1,
  "price": -1,
  "category": "",
  "lowStockThreshold": -1
}

### Update product
PUT {{baseUrl}}/api/v1/products/1
Content-Type: application/json

{
  "name": "Mouse Gamer RGB",
  "sku": "MOU-001-RGB",
  "quantity": 20,
  "price": 249.90,
  "category": "Peripherals",
  "lowStockThreshold": 4
}

### Decrease stock
PATCH {{baseUrl}}/api/v1/products/1/stock
Content-Type: application/json

{
  "quantityChange": -3
}

### Increase stock
PATCH {{baseUrl}}/api/v1/products/1/stock
Content-Type: application/json

{
  "quantityChange": 10
}

### Invalid stock adjustment
PATCH {{baseUrl}}/api/v1/products/1/stock
Content-Type: application/json

{
  "quantityChange": -999
}

### Update product not found
PUT {{baseUrl}}/api/v1/products/999
Content-Type: application/json

{
  "name": "Produto Fantasma",
  "sku": "GHO-999",
  "quantity": 1,
  "price": 10.00,
  "category": "Other",
  "lowStockThreshold": 1
}

### Update invalid product
PUT {{baseUrl}}/api/v1/products/1
Content-Type: application/json

{
  "name": "",
  "sku": "",
  "quantity": -1,
  "price": -1,
  "category": "",
  "lowStockThreshold": -1
}

### Delete product by id
DELETE {{baseUrl}}/api/v1/products/1

### Delete product not found
DELETE {{baseUrl}}/api/v1/products/999

### Create first product with unique sku
POST {{baseUrl}}/api/v1/products
Content-Type: application/json

{
  "name": "Headset",
  "sku": "HEA-888",
  "quantity": 8,
  "price": 349.90,
  "category": "Audio",
  "lowStockThreshold": 3
}

### Create second product with duplicate sku
POST {{baseUrl}}/api/v1/products
Content-Type: application/json

{
  "name": "Headset Pro",
  "sku": "HEA-888",
  "quantity": 12,
  "price": 499.90,
  "category": "Audio",
  "lowStockThreshold": 3
}
